@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels
@using GamesAdminMonitoring.Site.Enumeration;
@model SettlementBoardViewModel

@inject GamesAdminMonitoring.Site._Shared.Configurations.IAppSettings appSettings

@functions{
    public string GetSymbolImage(byte symbol)
    {
        const byte jackpotId = 10;
        if (symbol == jackpotId && Model.SystemType.Equals(SystemType.VG2Value) && Model.GameName.Equals(Game.FourGuardiansValue))
        {
            return "10-jackpot";
        }
        else
        {
            return symbol.ToString();
        }
    }
}

@if (Model.IsError)
{
    <div class="message-error" id="failedMsg">
        Sending result unsuccessfully. The following conditions that must be satisfied in order to monitor board result.<br />
        - Result cannot be set for real user and banned bot. <br />
        - Result cannot be set for UUS user when the "Exclude UUS" setting is TRUE. <br />
    </div>
}
else
{
    <table class="table table-bordered table-four-guardians">
        <thead>
            <tr>
                <th>Winning Paylines</th>
                <th>Free Spins</th>
                <th>Bonus</th>

                <th>Board</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @Model.WinningPaylines
                </td>
                <td>
                    @Model.NumberOfFreeSpins
                </td>
                <td>
                    @Model.NumberOfBonus
                </td>
                <td>
                    <table class="table-paylines">
                        <tbody>
                            @{
                                for (var row = 0; row < Model.FormattedBoard.Length; row++)
                                {
                                    <tr>
                                        @for (var column = 0; column < Model.FormattedBoard[row].Length; column++)
                                        {
                                            <td><img class="symbol" src="@appSettings.StaticResourceHost/@Model.GameName/symbol-@(GetSymbolImage(Model.FormattedBoard[row][column])).png?v=2" /></td>
                                        }
                                    </tr>

                                }
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
}