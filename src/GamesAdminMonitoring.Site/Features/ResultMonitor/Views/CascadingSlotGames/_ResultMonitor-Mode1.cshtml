@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels
@model SettlementCascadingSlotResultViewModel
@if (!Model.IsValid)
{
    <div class="message-error" id="failedMsg">
        Sending result unsuccessfully. The following conditions that must be satisfied in order to monitor board result.<br />
        - Result cannot be set for real user and banned bot. <br />
        - Result cannot be set for UUS user when the "Exclude UUS" setting is TRUE. <br />
    </div>
}
else
{
    <table class="table table-bordered table-four-guardians">
        <thead>
            <tr>
                <th>Winning Paylines</th>
                <th>Free Spins</th>
                <th>Bonus</th>
                <th>Board</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @* @Model.WinningPaylines*@
                </td>
                <td>
                    @*     @Model.NumberOfFreeSpins*@
                </td>
                <td>
                    @*  @Model.NumberOfBonus*@
                </td>
                <td>
                    @{
                        @foreach (var matrix in Model.ResultMatrixs)
                        {
                            <table class="table-paylines">
                                <tbody>
                                    @{
                                        @for (int i = 0; i < matrix.GetLength(0); i++)
                                        {
                                            <tr>
                                                @for (int a = 0; a < matrix.GetLength(1); a++)
                                                {
                                                    <td><img class="symbol" src="~/images/cascading-slot-icons/@Model.GameName/@( Int32.Parse(matrix[i, a]) +1 ).png" /></td>
                                                }
                                            </tr>

                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @*@{
                            <div class="table-paylines">
                                @foreach (var matrix in Model.ResultMatrixs)
                                {
                                    <div style="display: block; border: 1px solid gray; margin-top: 10px;">
                                        @for (int i = 0; i < matrix.GetLength(0); i++)
                                        {
                                            <div style="display: block">
                                                @for (int a = 0; a < matrix.GetLength(1); a++)
                                                {
                                                    <div style="display: inline-block; width: 100px;">
                                                        @matrix[i, a]
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>


                        }*@
                </td>
            </tr>
        </tbody>
    </table>
}

