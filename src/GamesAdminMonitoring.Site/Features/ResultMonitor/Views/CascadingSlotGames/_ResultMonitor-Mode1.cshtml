@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels
@model SettlementCascadingSlotResultViewModel

@if (!Model.IsValid)
{
    <div class="message-error" id="failedMsg">
        Sending result unsuccessfully. The following conditions that must be satisfied in order to monitor board result.<br />
        - Result cannot be set for real user and banned bot. <br />
        - Result cannot be set for UUS user when the "Exclude UUS" setting is TRUE. <br />
    </div>
}
else
{
    <table class="table table-bordered table-four-guardians">
        <thead>
            <tr>
                <th>Type</th>
                <th>Winning Symbol</th>
                <th>Number Of Symbol</th>
                <th>Multiplier</th>
                <th>Scatter</th>
                <th>Result Board</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var matrix in Model.ResultMatrixs)
            {
                var symbols = matrix.WinningSymbols.ToList();
                var rowspans = symbols.Count();
                for (int i = 0; i < rowspans; i++)
                {
                    if (i == 0)
                    {
                        <tr>
                            <td rowspan="@rowspans">
                                @matrix.Name
                            </td>
                            <td>
                                @(symbols[i].NumberOfSymbol == 0 ? "-" : symbols[i].Symbol.ToString())
                            </td>
                            <td>
                                @(symbols[i].NumberOfSymbol == 0 ? "-" : symbols[i].NumberOfSymbol.ToString())
                            </td>
                            <td rowspan="@rowspans">
                                @matrix.Multipliers
                            </td>
                            <td rowspan="@rowspans">
                                @matrix.Scatters
                            </td>
                            <td rowspan="@rowspans">
                                <table class="table-paylines">
                                    <tbody>
                                        @{
                                            var rows = matrix.Value.GetLength(0);
                                            var columns = matrix.Value.GetLength(1);
                                            @for (int x = 0; x < rows; x++)
                                            {
                                                <tr>
                                                    @for (int y = 0; y < columns; y++)
                                                    {
                                                        <td><img class="symbol" style="width:50px; height: 50px;" src="~/images/cascading-slot-icons/@Model.GameName/@(Int32.Parse(matrix.Value[x,y]) + 1 ).png" /></td>
                                                    }
                                                </tr>

                                            }
                                        }

                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>

                            <td>
                                @symbols[i].Symbol
                            </td>
                            <td>
                                @symbols[i].NumberOfSymbol
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
}


