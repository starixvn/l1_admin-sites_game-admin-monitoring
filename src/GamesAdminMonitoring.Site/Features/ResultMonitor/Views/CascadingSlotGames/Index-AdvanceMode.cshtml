@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels;
@model CascadingSlotResultViewModel

@{
    ViewData["Title"] = $"{Model.DisplayGameName} Result Controller";
}

@section Styles {
    <link href="~/css/cascading-slot-result.min.css" rel="stylesheet" asp-append-version="true" />
}

<div id="navbar">
    <ul class="nav nav-tabs justify-content-center">
        <li class="nav-item">
            <a class="nav-link" role="tab" aria-controls="EasyMode"
               href="@Url.Action("CascadingSlotResultEasyMode", "ResultMonitor",new { gameConfigName = Model.GameName, token = Model.Token })">Easy Mode</a>
        </li>
        <li class="nav-item ">
            <a class="nav-link active" role="tab" aria-controls="AdvanceMode">Advance Mode</a>
        </li>
    </ul>
</div>

<div class="form filter">
    <div class="form-row align-items-center">
        <input type="hidden" asp-for="GameName" />
        <div class="col-auto">
            <label asp-for="Nickname" class="control-label nickname-label"></label>
        </div>
        <div class="col-auto">
            <input type="text" class="form-control" placeholder="Nickname" asp-for="Nickname" onkeyup="cascadingSlotGameResultBase.onInputNickname(event)">
            <div class="error hidden">Please input nickname !</div>
        </div>
        <div class="col-auto">
            @using (Html.BeginForm("Excel", "ResultMonitor", FormMethod.Post))
            {
                <input type="submit" class="btn-primary" value="Export Template" />
            }
        </div>
        <div class="col-auto">
            <input class="hidden" type="file" id="file" name="file" accept=".xls,.xlsx" onchange="cascadingSlotGameResult.importTemplateResults(event)" />
            <label class="btn-primary" for="file">Import Template & Set Result </label>
        </div>
    </div>
    <div class="form-row align-items-center" id="result-container">
    </div>

    <div class="form-row align-items-center">
        <div class="col-auto">
            <button type="button" class="btn-primary" onclick="cascadingSlotGameResultBase.addTumble()">Add Tumble</button>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn-submit" onclick="cascadingSlotGameResult.submit(event)">Submit</button>
        </div>
    </div>
    <div id="preloader" class="hidden">
        <div id="loader"></div>
    </div>
</div>

<section id="attempts">
    <template>
        <div class="advance-mode">
            <span class="attempt"></span>
            <div class="result-container">
                @for (decimal index = 0; index <= 10; index++)
                {
                    <div class="board-row">
                        <div class="board-column"><img class="symbol" src="~/images/cascading-slot-icons/@Model.GameName/@(index + 1).png" /></div>
                        <div style="display: inline-block">
                            @Html.DropDownList($"Item-{index}", Enumerable.Range(0, 31).Select(i => new SelectListItem { Text = i.ToString(), Value = i.ToString() }), new { data_no = index })
                        </div>
                    </div>

                }
            </div>
        </div>

    </template>
</section>

<div id="set-result" class="col-sm-12 report-container">
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/js/cascading-slot-game-result/cascading-slot-game-result-advance-mode.js" asp-append-version="true"></script>
        <script src="~/js/cascading-slot-game-result/cascading-slot-game-result.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/cascading-slot-game-result/cascading-slot-game-result-advance-mode.min.js" asp-append-version="true"></script>
    </environment>
}
