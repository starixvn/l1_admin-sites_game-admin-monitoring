@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels;
@model CascadingSlotResultViewModel

@{
    ViewData["Title"] = $"{Model.DisplayGameName} Result Controller";
}

@section Styles {
    <link href="~/css/cascading-slot-result.min.css" rel="stylesheet" asp-append-version="true" />
}

<div>
    <ul class="nav nav-tabs justify-content-center">
        <li class="nav-item">
            <a class="nav-link" role="tab" aria-controls="EasyMode"
               href="@Url.Action("CascadingSlotResultEasyMode", "ResultMonitor",new { gameConfigName = Model.GameName, token = Model.Token })">Easy Mode</a>
        </li>
        <li class="nav-item ">
            <a class="nav-link active" role="tab" aria-controls="AdvanceMode">Advance Mode</a>
        </li>
    </ul>
</div>

<form class="form filter">
    <div class="form-row align-items-center">
        <input type="hidden" asp-for="GameName" />
        <div class="col-auto">
            <label asp-for="Nickname" class="control-label"></label>
            <input type="text" class="form-control" placeholder="Nickname" asp-for="Nickname" onkeyup="cascadingSlotGameResult.onInputNickname(event)">
            <div class="error hidden">Please input nickname !</div>
        </div>
        <div id="result-container">
        </div>
        <div class="col-auto mt-5">
            <button type="button" class="btn-submit" onclick="cascadingSlotGameResult.addTumble()">Add Tumble</button>
        </div>

        <div class="col-auto mt-5">
            <button type="submit" class="btn-submit" onclick="cascadingSlotGameResult.submit(event)">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<section id="attempts">
    <template>
        <div style="padding: 5px; margin-top: 10px;" class="result-temp">
            <span class="attempt" style="display: inline-block; vertical-align:top;"></span>
            <div style="border: 1px solid gray;display: inline-block; padding: 5px;">
                @for (decimal index = 0; index <= 10; index++)
                {
                    <div style="display: inline-block; margin-left:50px;">
                        <div class="board-column" style="display: inline-block"><img style="width: 50px; height:50px;" class="symbol" src="~/images/cascading-slot-icons/@Model.GameName/@(index + 1).png" /></div>
                        <div style="display: inline-block">
                            @Html.DropDownList($"Item-{index}", Enumerable.Range(0, 31).Select(i => new SelectListItem { Text = i.ToString(), Value = i.ToString() }), new { data_no = index })
                        </div>
                    </div>

                }
            </div>
        </div>

    </template>
</section>

<div id="set-result" class="col-sm-12 report-container">
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/js/cascading-slot-game-result-advance-mode.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/cascading-slot-game-result-advance-mode.min.js" asp-append-version="true"></script>
    </environment>
}
