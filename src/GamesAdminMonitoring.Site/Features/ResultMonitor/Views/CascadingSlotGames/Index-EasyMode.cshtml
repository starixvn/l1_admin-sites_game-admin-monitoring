@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels;
@model CascadingSlotResultViewModel

@{
    ViewData["Title"] = $"{Model.DisplayGameName} Result Controller";
}

@section Styles {
    <link href="~/css/cascading-slot-result.min.css" rel="stylesheet" asp-append-version="true" />
}
<div>
    <ul class="nav nav-tabs justify-content-center">
        <li class="nav-item">
            <a class="nav-link active" role="tab" aria-controls="EasyMode">Easy Mode</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" role="tab" aria-controls="AdvanceMode"
               href="@Url.Action("CascadingSlotResultAdvanceMode", "ResultMonitor",new { gameConfigName = Model.GameName, token = Model.Token })">Advance Mode</a>
        </li>
    </ul>
</div>
<form class="form filter">
    <div class="form-row align-items-center">
        <input type="hidden" asp-for="GameName" />
        <div class="col-auto">
            <label asp-for="Nickname" class="control-label"></label>
            <input type="text" class="form-control" placeholder="Nickname" asp-for="Nickname" onkeyup="cascadingSlotGameResult.onInputNickname(event)">
            <div class="error hidden">Please input nickname !</div>
        </div>
        <fieldset class="col-auto" id="result-container">
            <legend>Set Result</legend>
        </fieldset>
        <div class="col-auto mt-5">
            <button type="submit" class="btn-submit" onclick="cascadingSlotGameResult.submit(event)">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<section id="attempts">
    <template>
        <div class="result-temp">
            <div class="tumble-title"><span class="attempt"></span></div>
            <div class="tumble-content">
                <input type="text" class="result-raw">
            </div>
            <div class="mt-5">
                <button type="button" class="btn btn-primary add-tumble" onclick="cascadingSlotGameResult.addTumble()">Add Tumble</button>
            </div>
        </div>
    </template>
</section>

<div id="set-result" class="col-sm-12 report-container">
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/js/cascading-slot-game-result-easy-mode.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/cascading-slot-game-result-easy-mode.min.js" asp-append-version="true"></script>
    </environment>
}
