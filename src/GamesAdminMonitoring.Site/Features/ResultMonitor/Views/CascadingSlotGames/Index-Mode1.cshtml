@using GamesAdminMonitoring.Site.Features.ResultMonitor.ViewModels;
@model CascadingSlotResultViewModel

@{
    ViewData["Title"] = $"{Model.DisplayGameName} Result Controller";
}

@section Styles {
    <link href="~/css/big-small-reports.min.css" rel="stylesheet" asp-append-version="true" />
}
<form class="form filter" data-ajax="true" data-ajax-method="POST" asp-action="SetSlotResult" data-ajax-mode="replace" data-ajax-update="#set-result"
      data-ajax-loading="#spinner"
      method="POST">
    <div class="form-row align-items-center">
        <input type="hidden" asp-for="GameName" />
        <div class="col-auto">
            <label asp-for="Nickname" class="control-label"></label>
            <input type="text" class="form-control" placeholder="Nickname" asp-for="Nickname">
        </div>
        <div id="result-container" style="border: 1px gray solid; padding: 5px;">
        </div>
        <div class="col-auto mt-5">
            <button type="button" class="btn-submit" onclick="cascadingSlotGameResult.addTumble()">Add Tumble</button>
        </div>

        <div class="col-auto mt-5">
            <button type="submit" class="btn-submit" onclick="cascadingSlotGameResult.submit(event)">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<section id="attempts">
    <template>
        <div style="margin-top: 10px;" class="result-temp">
            <span class="attempt"></span>
            <div style="display: inline-block">
                <input type="text" class="result-raw">
            </div>
        </div>

    </template>
</section>

<div id="set-result" class="col-sm-12 report-container">
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/js/cascading-slot-game-result-mode1.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/cascading-slot-game-result-mode1.min.js" asp-append-version="true"></script>
    </environment>
}
